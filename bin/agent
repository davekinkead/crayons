#!/usr/bin/env ruby
# frozen_string_literal: true

require "dotenv/load"
require_relative "../lib/ralph"
require "optparse"

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: bin/agent --agent AGENT_NAME --call INSTRUCTIONS"

  opts.on("--agent NAME", "Agent name to call") do |name|
    options[:agent] = name
  end

  opts.on("--call INSTRUCTIONS", "Instructions to pass to the agent") do |instructions|
    options[:instructions] = instructions
  end

  opts.on("-h", "--help", "Prints this help") do
    puts opts
    exit
  end
end.parse!

if options[:agent].nil? || options[:instructions].nil?
  puts "Error: Both --agent and --call are required"
  puts ""
  puts "Usage: bin/agent --agent AGENT_NAME --call INSTRUCTIONS"
  exit 1
end

agent = Ralph::Agent.new(options[:agent])
response = agent.call(options[:instructions])

puts response
